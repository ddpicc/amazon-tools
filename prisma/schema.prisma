generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserPlan {
  FREE
  PRO
}

enum UserRole {
  ADMIN
  MEMBER
}

enum TrackedAsinStatus {
  ACTIVE
  PAUSED
}

enum TrackedAsinRole {
  OWN
  COMPETITOR
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  RESOLVED
}

enum SyncJobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum NotificationChannelType {
  INBOX
  FEISHU
  WECOM
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
}

enum MonitoringSubscriptionType {
  ASIN
  KEYWORD
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  plan         UserPlan  @default(FREE)
  role         UserRole  @default(MEMBER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
  inboxNotifications InboxNotification[]
  emailVerificationCodes EmailVerificationCode[]
}

model EmailVerificationCode {
  id         String   @id @default(cuid())
  userId     String?
  email      String
  purpose    String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@index([consumedAt])
}

model Project {
  id                   String                 @id @default(cuid())
  userId               String
  name                 String
  marketplace          String
  syncFrequencyMinutes Int                    @default(1440)
  notificationEmail    String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackedAsins         TrackedAsin[]
  keywords             Keyword[]
  keywordSnapshots     KeywordRankSnapshot[]
  alerts               Alert[]
  syncJobs             SyncJob[]
  apiUsageLogs         ApiUsageLog[]
  settings             ProjectSettings?
  notificationChannels NotificationChannel[]
  inboxNotifications   InboxNotification[]
  notificationDeliveries NotificationDelivery[]
  monitoringSubscriptions MonitoringSubscription[]
  alertSuppressions    AlertSuppressionLog[]
  dailyDigestRuns      DailyDigestRun[]

  @@index([userId])
  @@index([marketplace])
}

model TrackedAsin {
  id                  String             @id @default(cuid())
  projectId           String
  asin                String
  marketplace         String
  role                TrackedAsinRole    @default(COMPETITOR)
  title               String?
  brand               String?
  category            String?
  status              TrackedAsinStatus  @default(ACTIVE)
  lastSyncedAt        DateTime?
  lastSuccessAt       DateTime?
  consecutiveFailures Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshots           ProductSnapshot[]
  keywordSnapshots    KeywordRankSnapshot[]
  alerts              Alert[]
  syncJobs            SyncJob[]
  apiUsageLogs        ApiUsageLog[]
  monitoringSubscriptions MonitoringSubscription[]
  alertSuppressions   AlertSuppressionLog[]

  @@unique([projectId, asin])
  @@index([projectId])
  @@index([asin])
  @@index([status])
  @@index([role])
}

model ProductSnapshot {
  id            String      @id @default(cuid())
  trackedAsinId String
  storeName     String?
  asinSalesCount Int?
  parentAsin    String?
  price         Decimal?    @db.Decimal(12, 2)
  listPrice     Decimal?    @db.Decimal(12, 2)
  listingSaleCount Int?
  listingSaleCountOfDaily Json?
  coupon        Int?
  rating        Decimal?    @db.Decimal(3, 2)
  reviewCount   Int?
  bsr           Int?
  bsrCategory   Json?
  variantCount  Int?
  stockStatus   String?
  title         String?
  photoUrls     Json?
  ebcPhotoUrls  Json?
  brand         String?
  description   String?
  buyboxSeller  String?
  buyboxSellerId String?
  isFBA         Boolean?
  shipCost      Int?
  onlineDate    DateTime?
  onlineDays    Int?
  category      String?
  categoryNodeId String?
  hasVideo      Boolean?
  aPlus         Boolean?
  hasBrandStore Boolean?
  packageSize   Json?
  weightGrams   Int?
  extraSavings  Json?
  properties    Json?
  rawPayload    Json?
  capturedAt    DateTime
  createdAt     DateTime    @default(now())
  trackedAsin   TrackedAsin @relation(fields: [trackedAsinId], references: [id], onDelete: Cascade)

  @@index([trackedAsinId, capturedAt(sort: Desc)])
  @@index([capturedAt(sort: Desc)])
}

model Keyword {
  id              String                @id @default(cuid())
  projectId       String
  keyword         String
  source          String                @default("manual")
  enabled         Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rankSnapshots   KeywordRankSnapshot[]

  @@unique([projectId, keyword])
  @@index([projectId])
  @@index([enabled])
}

model KeywordRankSnapshot {
  id            String       @id @default(cuid())
  projectId     String
  trackedAsinId String
  keywordId     String
  rank          Int?
  page          Int?
  rawPayload    Json?
  capturedAt    DateTime
  createdAt     DateTime     @default(now())
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trackedAsin   TrackedAsin  @relation(fields: [trackedAsinId], references: [id], onDelete: Cascade)
  keyword       Keyword      @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([projectId, capturedAt(sort: Desc)])
  @@index([trackedAsinId, keywordId, capturedAt(sort: Desc)])
  @@index([keywordId, capturedAt(sort: Desc)])
}

model Alert {
  id            String        @id @default(cuid())
  projectId     String
  trackedAsinId String
  type          String
  severity      AlertSeverity
  status        AlertStatus   @default(OPEN)
  title         String
  message       String?
  oldValue      String?
  newValue      String?
  changeValue   String?
  payload       Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trackedAsin   TrackedAsin   @relation(fields: [trackedAsinId], references: [id], onDelete: Cascade)
  inboxNotifications InboxNotification[]
  notificationDeliveries NotificationDelivery[]
  suppressionLogs AlertSuppressionLog[]

  @@index([projectId, createdAt(sort: Desc)])
  @@index([trackedAsinId, createdAt(sort: Desc)])
  @@index([status])
}

model SyncJob {
  id            String        @id @default(cuid())
  projectId     String?
  trackedAsinId String?
  jobType       String
  status        SyncJobStatus @default(PENDING)
  attemptCount  Int           @default(0)
  scheduledAt   DateTime
  startedAt     DateTime?
  finishedAt    DateTime?
  errorMessage  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trackedAsin   TrackedAsin?  @relation(fields: [trackedAsinId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([trackedAsinId])
}

model ApiUsageLog {
  id                String       @id @default(cuid())
  projectId         String
  trackedAsinId     String?
  apiName           String
  requestConsumed   Int          @default(1)
  requestLeft       Int?
  status            String
  errorMessage      String?
  contextRef        String?
  calledAt          DateTime     @default(now())
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trackedAsin       TrackedAsin? @relation(fields: [trackedAsinId], references: [id], onDelete: Cascade)

  @@index([projectId, calledAt(sort: Desc)])
  @@index([apiName, calledAt(sort: Desc)])
}

model ProjectSettings {
  id                           String    @id @default(cuid())
  projectId                    String    @unique
  priceChangeThresholdPercent  Decimal?  @db.Decimal(6, 2)
  priceChangeThresholdValue    Decimal?  @db.Decimal(12, 2)
  ratingDropThreshold          Decimal   @default(0.20) @db.Decimal(3, 2)
  reviewGrowthThreshold        Int       @default(20)
  bsrChangeThresholdPercent    Decimal   @default(20.00) @db.Decimal(6, 2)
  immediateCriticalAlertEnabled Boolean  @default(false)
  manualRefreshLimitPerDay     Int       @default(10)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  project                      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model NotificationChannel {
  id          String                  @id @default(cuid())
  projectId   String
  type        NotificationChannelType
  enabled     Boolean                 @default(true)
  name        String?
  webhookUrl  String?
  email       String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries  NotificationDelivery[]

  @@unique([projectId, type])
  @@index([projectId])
  @@index([enabled])
}

model InboxNotification {
  id          String    @id @default(cuid())
  userId      String
  projectId   String
  alertId     String
  title       String
  message     String?
  readAt      DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  alert       Alert     @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([userId, alertId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([readAt])
}

model NotificationDelivery {
  id            String                     @id @default(cuid())
  projectId     String
  alertId       String
  channelId     String?
  channelType   NotificationChannelType
  status        NotificationDeliveryStatus @default(PENDING)
  retryCount    Int                        @default(0)
  nextRetryAt   DateTime?
  lastRetriedAt DateTime?
  errorMessage  String?
  responseBody  String?
  deliveredAt   DateTime?
  createdAt     DateTime                   @default(now())
  project       Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  alert         Alert                      @relation(fields: [alertId], references: [id], onDelete: Cascade)
  channel       NotificationChannel?       @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([alertId, createdAt(sort: Desc)])
  @@index([channelType, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([nextRetryAt, status])
}

model MonitoringSubscription {
  id              String                     @id @default(cuid())
  projectId       String
  trackedAsinId   String?
  type            MonitoringSubscriptionType
  externalStatus  String?
  enabled         Boolean                    @default(true)
  keywordsDigest  String?
  asinDigest      String?
  lastBatchId     String?
  lastSyncedAt    DateTime?
  rawPayload      Json?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  project         Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trackedAsin     TrackedAsin?               @relation(fields: [trackedAsinId], references: [id], onDelete: Cascade)

  @@unique([projectId, trackedAsinId, type])
  @@index([projectId, type])
  @@index([trackedAsinId, type])
  @@index([enabled, type])
}

model AlertSuppressionLog {
  id               String      @id @default(cuid())
  projectId        String
  trackedAsinId    String
  type             String
  title            String
  fingerprint      String
  duplicateAlertId String?
  cooldownMinutes  Int
  payload          Json?
  createdAt        DateTime    @default(now())
  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trackedAsin      TrackedAsin @relation(fields: [trackedAsinId], references: [id], onDelete: Cascade)
  duplicateAlert   Alert?      @relation(fields: [duplicateAlertId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([trackedAsinId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@index([fingerprint])
}

model DailyDigestRun {
  id           String   @id @default(cuid())
  projectId    String
  digestDate   DateTime
  status       String
  summary      String
  channelResults Json?
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, digestDate])
  @@index([projectId, digestDate(sort: Desc)])
  @@index([status, digestDate(sort: Desc)])
}
